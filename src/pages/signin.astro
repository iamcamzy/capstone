---
import ShowButton from '../components/showButton.astro';
import Layout from '../layouts/Layout.astro';
import { clearSessionCookies, getUser, isEmailVerified } from '../lib/auth';
export const prerender = false;

const { cookies, url } = Astro;
const currentUser = await getUser(cookies);
if (currentUser && isEmailVerified(currentUser)) return Astro.redirect('/dashboard');
if (currentUser) clearSessionCookies(cookies);

const errorMsg = url.searchParams.get('error');
const isUnverified = url.searchParams.get('unverified') === '1';
const unverifiedEmail = url.searchParams.get('email') ?? '';
---

<Layout title="Sign in">
  <div class="auth-page w-full min-h-[69vh] flex justify-center items-center py-12 px-4">
    <div id="formBox" class="auth-card w-full max-w-md ring-2 rounded-xl">
      <div id="formHeader" class="auth-card__header border-b w-full px-6 py-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold">Log in</h1>
        <a href="/" class="auth-back flex justify-center items-center text-sm rounded-2xl py-1 px-4 ring-1 text-white">Back</a>
      </div>

      {errorMsg && (
        <div class="mx-6 mt-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
          {decodeURIComponent(errorMsg)}
        </div>
      )}

      {isUnverified && (
        <div class="mx-6 mt-4 p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-sm">
          Please verify your email before signing in. You can resend the verification email below.
        </div>
      )}

      <form action="/api/auth/signin" method="post" class="px-6 pt-8 pb-4 space-y-5">
        <div>
          <label for="email" class="block text-sm font-bold mb-1">Email</label>
          <input id="email" name="email" type="email" required value={unverifiedEmail}
            class="w-full p-2 pl-4 rounded ring focus:outline-none focus:ring-2" />
        </div>
        <div class="relative">
          <label for="password" class="block text-sm font-bold mb-1">Password</label>
          <input id="password" name="password" type="password" required
            class="w-full p-2 pl-4 rounded ring focus:outline-none focus:ring-2" />
          <ShowButton />
        </div>
        <button type="submit"
          class="auth-submit w-full text-lg text-white font-bold rounded-2xl py-2 px-5 hover:cursor-pointer transition">
          Log in
        </button>
      </form>
      <div class="px-6 pb-5 text-center">
        <button id="resendVerification" type="button" class="auth-link underline text-sm">Resend verification email</button>
        <div id="resendNotice" class="hidden mt-3 p-3 rounded-lg text-sm font-semibold"></div>
      </div>
      <p class="flex justify-end pb-4 px-6 gap-2 text-sm">
        New here?
        <a href="/signup" class="auth-link underline">Create an account</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  const resendButton = document.getElementById('resendVerification') as HTMLButtonElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const resendNotice = document.getElementById('resendNotice');

  function showResendNotice(message: string, success: boolean) {
    if (!resendNotice) return;
    resendNotice.textContent = message;
    resendNotice.className = 'mt-3 p-3 rounded-lg text-sm font-semibold '
      + (success ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800');
  }

  resendButton?.addEventListener('click', async () => {
    const email = emailInput?.value.trim() ?? '';
    if (!email) {
      showResendNotice('Enter your email address first.', false);
      return;
    }

    resendButton.disabled = true;
    try {
      const response = await fetch('/api/auth/resend-verification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await response.json().catch(() => ({}));
      showResendNotice(data.message ?? data.error ?? 'Unable to resend verification email.', response.ok);
    } catch {
      showResendNotice('Unable to resend verification email. Please try again.', false);
    } finally {
      resendButton.disabled = false;
    }
  });
</script>

<style>
  .auth-page {
    background:
      radial-gradient(circle at 12% 8%, rgba(232, 242, 227, 0.78), transparent 26rem),
      var(--wb-surface);
  }

  .auth-card {
    overflow: hidden;
    border: 1px solid var(--wb-border);
    background: var(--wb-surface-raised);
    box-shadow: var(--wb-shadow-md);
    color: var(--wb-text);
  }

  .auth-card__header {
    border-color: var(--wb-border);
    background: var(--wb-surface-soft);
  }

  .auth-card h1 {
    color: var(--wb-green-dark);
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  .auth-card input {
    border: 1px solid var(--wb-border);
    background: #fff;
    color: var(--wb-text);
  }

  .auth-card input:focus {
    border-color: var(--wb-green);
    box-shadow: 0 0 0 4px rgba(74, 124, 63, 0.12);
  }

  .auth-back {
    border-color: rgba(154, 74, 54, 0.32);
    background: #9a4a36;
    text-decoration: none;
  }

  .auth-submit {
    background: var(--wb-green);
  }

  .auth-submit:hover {
    background: var(--wb-green-mid);
  }

  .auth-link {
    color: var(--wb-green-mid);
    font-weight: 700;
  }

  :global(html.dark) .auth-page {
    background:
      radial-gradient(circle at 12% 8%, rgba(37, 56, 35, 0.72), transparent 26rem),
      var(--wb-surface);
  }

  :global(html.dark) .auth-card input {
    background: var(--wb-surface-soft) !important;
    color: var(--wb-text) !important;
  }
</style>
