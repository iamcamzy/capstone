---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Payment Cancelled"><main class="min-h-[70vh] grid place-items-center px-4"><section class="max-w-xl rounded-2xl border bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-bold">Payment not completed</h1><p class="mt-3 text-gray-600">Your booking was kept, but no payment was recorded. You can retry from your dashboard.</p><a href="/dashboard" class="inline-block mt-6 rounded-xl px-5 py-3 text-white font-semibold" style="background:#4a7c3f">Return to dashboard</a></section></main></Layout>
