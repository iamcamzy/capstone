---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    label: 'Private Resort Venue',
    icon: 'home',
  },
  {
    label: 'Pool Access',
    icon: 'waves',
  },
  {
    label: 'Event Pavilion',
    icon: 'pavilion',
  },
  {
    label: 'Staycation Packages',
    icon: 'bed',
  },
  {
    label: 'Sound System / Videoke',
    icon: 'music',
  },
];

const packages = [
  {
    title: 'Lunch Time Package',
    price: '₱12,000',
    description:
      'A bright daytime celebration with the resort setting ready for your group.',
    tag: 'Day event',
  },
  {
    title: 'Dinner Time Package',
    price: '₱13,000',
    description:
      'Gather under the evening lights for birthdays, reunions, and special dinners.',
    tag: 'Evening event',
  },
  {
    title: 'Barkada Staycation',
    price: '₱14,500',
    description:
      'Make time for the whole crew with a fun and easy private resort escape.',
    tag: 'For friends',
  },
  {
    title: 'Pamilya Staycation',
    price: '₱20,500',
    description:
      'Share a comfortable family getaway with space to swim, relax, and reconnect.',
    tag: 'For families',
  },
  {
    title: 'Room Rates',
    price: 'Starts at ₱999',
    description:
      'Add a comfortable room to your visit or plan a simple overnight stay.',
    tag: 'Overnight stay',
  },
];

const reasons = [
  {
    title: 'Pool and pavilion access',
    description: 'Enjoy spaces for both relaxing and celebrating in one venue.',
  },
  {
    title: 'A private place for your event',
    description: 'Gather with the people who matter in a more personal setting.',
  },
  {
    title: 'Flexible staycation options',
    description: 'Choose a quick escape with friends or quality time with family.',
  },
  {
    title: 'Parking and security support',
    description: 'Welcome your guests with practical on-site support for the occasion.',
  },
  {
    title: 'Caterer-friendly preparation time',
    description: 'Give your chosen caterer time to prepare the celebration with care.',
  },
  {
    title: 'Made for families and groups',
    description: 'A warm setting for birthdays, reunions, weddings, and shared milestones.',
  },
];

const bookingSteps = [
  {
    number: '01',
    title: 'Choose a package',
    description: 'Find the event or staycation option that suits your plans.',
  },
  {
    number: '02',
    title: 'Submit your booking request',
    description: 'Sign in with a verified email, then share your date, package, guests, and contact details.',
  },
  {
    number: '03',
    title: 'Review payment and terms',
    description: 'Check the 50% down payment, 48-hour unpaid reservation hold, and cancellation terms before you submit.',
  },
];

const galleryImages = [
  {
    src: '/woodberyPics/pool_1.jpg',
    alt: 'Woodberry swimming pool',
    className: 'gallery-tile gallery-tile--large',
  },
  {
    src: '/woodberyPics/banquet_1.jpg',
    alt: 'Woodberry pavilion prepared for an event',
    className: 'gallery-tile',
  },
  {
    src: '/woodberyPics/stage_2.jpg',
    alt: 'Decorated event stage at Woodberry',
    className: 'gallery-tile',
  },
  {
    src: '/woodberyPics/tables_1.jpg',
    alt: 'Celebration table setup at Woodberry',
    className: 'gallery-tile gallery-tile--wide',
  },
];
---

<Layout>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__image" aria-hidden="true">
        <img
          src="/woodberyPics/pool_and_house.jpg"
          alt=""
          width="905"
          height="1280"
          fetchpriority="high"
        />
      </div>

      <div class="home-hero__shade" aria-hidden="true"></div>

      <div class="home-hero__inner">
        <div class="home-hero__content">
          <p class="home-hero__eyebrow">
            Woodberry Resorts and Events Place
          </p>

          <h1 id="home-hero-title">
            Celebrate Your Special Moments at Woodberry
          </h1>

          <p class="home-hero__lead">
            Your private resort and events venue for birthdays, reunions,
            weddings, family gatherings, and easygoing staycations—all in one
            warm and inviting place.
          </p>

          <div class="home-hero__actions" aria-label="Explore Woodberry">
            <a
              href="/events_and_booking/events"
              class="hero-button hero-button--primary"
            >
              Book an Event
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a href="#packages" class="hero-button hero-button--glass">
              View Packages
            </a>
            <a href="/gallery" class="hero-button hero-button--text">
              View Gallery
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="home-hero__features" aria-label="Venue features">
          <p class="home-hero__features-title">Everything for your gathering</p>
          <ul>
            {
              features.map((feature) => (
                <li>
                  <span class="feature-icon" aria-hidden="true">
                    {feature.icon === 'home' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 11.5 12 4l9 7.5"></path>
                        <path d="M5.5 10v10h13V10M9.5 20v-6h5v6"></path>
                      </svg>
                    )}
                    {feature.icon === 'waves' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M2 9c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"></path>
                        <path d="M2 15c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"></path>
                      </svg>
                    )}
                    {feature.icon === 'pavilion' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 10h18M5 10v10M19 10v10M9 10v10M15 10v10"></path>
                        <path d="m2 10 10-6 10 6M3 20h18"></path>
                      </svg>
                    )}
                    {feature.icon === 'bed' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 19v-9M21 19v-6a3 3 0 0 0-3-3H9v6h12"></path>
                        <path d="M3 16h18M9 10a3 3 0 1 0-6 0v6"></path>
                      </svg>
                    )}
                    {feature.icon === 'music' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M9 18V5l11-2v13"></path>
                        <ellipse cx="6" cy="18" rx="3" ry="2"></ellipse>
                        <ellipse cx="17" cy="16" rx="3" ry="2"></ellipse>
                      </svg>
                    )}
                  </span>
                  <span>{feature.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <a class="home-hero__scroll" href="#packages" aria-label="Explore packages">
        <span>Discover more</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>
    </section>

    <section id="packages" class="packages-preview" aria-labelledby="packages-title">
      <div class="packages-preview__intro">
        <div>
          <p class="section-eyebrow">Featured packages</p>
          <h2 id="packages-title">A package for every kind of gathering</h2>
        </div>
        <p>
          Plan a daytime celebration, an evening event, or a relaxed overnight
          escape with clear starting options for your group.
        </p>
      </div>

      <div class="packages-grid">
        {
          packages.map((item) => (
            <article class="package-card">
              <p class="package-card__tag">{item.tag}</p>
              <div class="package-card__content">
                <h3>{item.title}</h3>
                <p class="package-card__price">{item.price}</p>
                <p>{item.description}</p>
              </div>
              <a href="/events_and_booking/events" aria-label={`View ${item.title}`}>
                View package
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <div class="packages-preview__actions">
        <a href="/events_and_booking/events" class="packages-link">
          Explore venues and packages
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="section-heading section-heading--center">
        <p class="section-eyebrow">Why choose Woodberry</p>
        <h2 id="why-title">One welcoming place, thoughtfully prepared</h2>
        <p>
          Bring everyone together with the resort spaces and practical support
          that help your celebration feel easier.
        </p>
      </div>

      <div class="reasons-grid">
        {
          reasons.map((reason) => (
            <article class="reason-card">
              <span class="reason-card__check" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="m6 12 4 4 8-9"></path>
                </svg>
              </span>
              <div>
                <h3>{reason.title}</h3>
                <p>{reason.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="booking-process" aria-labelledby="booking-process-title">
      <div class="booking-process__inner">
        <div class="booking-process__intro">
          <p class="section-eyebrow">Simple booking process</p>
          <h2 id="booking-process-title">From your plans to a reserved date</h2>
          <p>
            Start with the experience you want, send your preferred details,
            and let our team guide you toward contract signing.
          </p>
          <div class="reservation-note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            <p>
              <strong>Please remember:</strong> unpaid reservations are valid
              for 48 hours. The 50% down payment secures an approved booking.
            </p>
          </div>
        </div>

        <ol class="booking-steps">
          {
            bookingSteps.map((step) => (
              <li>
                <span class="booking-step__number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="gallery-preview" aria-labelledby="gallery-preview-title">
      <div class="gallery-preview__heading">
        <div>
          <p class="section-eyebrow">A glimpse of Woodberry</p>
          <h2 id="gallery-preview-title">Picture your celebration here</h2>
        </div>
        <a href="/gallery" class="outline-link">
          View full gallery
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="gallery-preview__grid">
        {
          galleryImages.map((image) => (
            <figure class={image.className}>
              <img
                src={image.src}
                alt={image.alt}
                width="640"
                height="480"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>

      <a href="/gallery" class="outline-link outline-link--mobile">
        View full gallery
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </section>

    <section class="contact-cta" aria-labelledby="contact-cta-title">
      <div class="contact-cta__image" aria-hidden="true">
        <img src="/woodberyPics/entrance_1.jpg" alt="" loading="lazy" />
      </div>
      <div class="contact-cta__shade" aria-hidden="true"></div>
      <div class="contact-cta__content">
        <p class="section-eyebrow">Your gathering starts here</p>
        <h2 id="contact-cta-title">Ready to make your Woodberry memories?</h2>
        <p>
          Tell us about your preferred date, package, and group. We would be
          happy to help you plan your event or resort stay.
        </p>
        <div class="contact-cta__actions">
          <a href="/events_and_booking/events" class="hero-button hero-button--primary">
            Book your date
          </a>
          <a href="/contact-us" class="hero-button hero-button--glass">
            Send an inquiry
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-page {
    background: var(--wb-surface);
    color: var(--wb-text);
  }

  .home-hero {
    position: relative;
    display: flex;
    min-height: max(43rem, calc(100svh - 70px));
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 9vw, 7.5rem) clamp(1rem, 6vw, 5.5rem);
    color: #ffffff;
  }

  .home-hero__image,
  .home-hero__shade {
    position: absolute;
    inset: 0;
  }

  .home-hero__image {
    z-index: -3;
    background: var(--wb-green-dark);
  }

  .home-hero__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    transform: scale(1.01);
  }

  .home-hero__shade {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgba(9, 22, 7, 0.94) 0%,
        rgba(13, 30, 10, 0.82) 37%,
        rgba(15, 31, 12, 0.38) 68%,
        rgba(15, 31, 12, 0.2) 100%
      ),
      linear-gradient(0deg, rgba(7, 17, 5, 0.56) 0%, transparent 42%);
  }

  .home-hero::before {
    position: absolute;
    z-index: -1;
    top: -10rem;
    left: -8rem;
    width: 30rem;
    height: 30rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    content: '';
  }

  .home-hero__inner {
    display: grid;
    width: min(100%, 76rem);
    align-items: end;
    gap: clamp(2rem, 7vw, 6rem);
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    margin: 0 auto;
  }

  .home-hero__content {
    max-width: 48rem;
  }

  .home-hero__eyebrow,
  .section-eyebrow {
    margin: 0 0 1rem;
    color: #f2bb78;
    font-size: clamp(0.7rem, 1.3vw, 0.8rem);
    font-weight: 800;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 47rem;
    margin: 0;
    color: #ffffff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.6rem, 6.8vw, 5.8rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .home-hero__lead {
    max-width: 42rem;
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.7;
  }

  .home-hero__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 4vw, 2.4rem);
    flex-wrap: wrap;
  }

  .hero-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.78rem 1.25rem;
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.035em;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
  }

  .hero-button svg,
  .packages-link svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .hero-button--primary {
    background: var(--wb-warm);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    color: #251605;
  }

  .hero-button--primary:hover {
    background: #f1b066;
  }

  .hero-button--glass {
    border-color: rgba(255, 255, 255, 0.48);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }

  .hero-button--glass:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.72);
  }

  .hero-button--text {
    padding-inline: 0.65rem;
  }

  .hero-button--text:hover {
    color: #f2bb78;
  }

  .home-hero__features {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--wb-radius-lg);
    background: rgba(12, 27, 9, 0.6);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
    padding: 1.4rem;
    backdrop-filter: blur(14px);
  }

  .home-hero__features-title {
    margin: 0 0 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .home-hero__features ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__features li {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .home-hero__features li:first-child {
    border-top: 0;
  }

  .feature-icon {
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    background: rgba(237, 155, 64, 0.18);
    color: #f2bb78;
  }

  .feature-icon svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .home-hero__scroll {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .home-hero__scroll svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .packages-preview {
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 6vw, 5.5rem);
    background:
      radial-gradient(circle at top right, rgba(232, 242, 227, 0.9), transparent 34rem),
      var(--wb-surface);
    scroll-margin-top: 70px;
  }

  .packages-preview__intro,
  .packages-grid,
  .packages-preview__actions {
    width: min(100%, 76rem);
    margin-inline: auto;
  }

  .packages-preview__intro {
    display: grid;
    align-items: end;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-eyebrow {
    margin-bottom: 0.55rem;
    color: var(--wb-green);
  }

  .packages-preview h2 {
    max-width: 42rem;
    margin: 0;
    color: var(--wb-green-dark);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4.8vw, 3.65rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .packages-preview__intro > p {
    margin: 0;
    color: var(--wb-muted);
    line-height: 1.7;
  }

  .packages-grid {
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .package-card {
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    grid-column: span 2;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-lg);
    background: var(--wb-surface-raised);
    box-shadow: var(--wb-shadow-sm);
    padding: clamp(1.25rem, 3vw, 1.6rem);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .package-card:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .package-card:hover {
    border-color: rgba(74, 124, 63, 0.42);
    box-shadow: var(--wb-shadow-md);
    transform: translateY(-3px);
  }

  .package-card__tag {
    width: fit-content;
    margin: 0 0 1.35rem;
    border-radius: 999px;
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
    padding: 0.35rem 0.7rem;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .package-card__content {
    flex: 1;
  }

  .package-card h3 {
    margin: 0;
    color: var(--wb-green-dark);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  .package-card p {
    margin: 0.7rem 0 0;
    color: var(--wb-muted);
    font-size: 0.91rem;
    line-height: 1.55;
  }

  .package-card .package-card__price {
    margin-top: 0.45rem;
    color: var(--wb-warm);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .package-card > a,
  .outline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.35rem;
    color: var(--wb-green-mid);
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
  }

  .package-card > a svg,
  .outline-link svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: transform 0.2s ease;
  }

  .package-card > a:hover svg,
  .outline-link:hover svg {
    transform: translateX(3px);
  }

  .packages-preview__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .packages-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid var(--wb-green);
    color: var(--wb-green-dark);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
  }

