---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/eventCards/eventCard.astro';
import AuthRequiredModal from '../../components/auth/AuthRequiredModal.astro';
import { getUser, isEmailVerified } from '../../lib/auth';
import { getAllVenues } from '../../services/venues';

const user = await getUser(Astro.cookies);
const authState: 'guest' | 'unverified' | 'verified' = user
  ? isEmailVerified(user)
    ? 'verified'
    : 'unverified'
  : 'guest';
const { data: venues } = await getAllVenues();
const venuesToDisplay = venues || [];

const packageOptions = [
  { value: 'lunch-time', label: 'Lunch Time Package', price: 12000, minGuests: 80, maxGuests: 200, eventTypes: ['wedding', 'birthday', 'reunion', 'family-gathering', 'corporate', 'conference', 'debut', 'private-event', 'other'] },
  { value: 'dinner-time', label: 'Dinner Time Package', price: 13000, minGuests: 80, maxGuests: 200, eventTypes: ['wedding', 'birthday', 'reunion', 'family-gathering', 'corporate', 'conference', 'debut', 'private-event', 'other'] },
  { value: 'barkada-staycation', label: 'Barkada Staycation', price: 14500, minGuests: 10, maxGuests: 15, eventTypes: ['birthday', 'reunion', 'family-gathering', 'staycation', 'private-event', 'other'] },
  { value: 'pamilya-staycation', label: 'Pamilya Staycation', price: 20500, minGuests: 20, maxGuests: 30, eventTypes: ['birthday', 'reunion', 'family-gathering', 'staycation', 'private-event', 'other'] },
  { value: 'room-rates', label: 'Room Rates', price: 999, minGuests: 1, maxGuests: 24, eventTypes: ['staycation', 'private-event', 'other'] },
];

const eventTypeOptions = [
  ['wedding', 'Wedding'],
  ['birthday', 'Birthday Party'],
  ['reunion', 'Reunion'],
  ['family-gathering', 'Family Gathering'],
  ['staycation', 'Staycation'],
  ['private-event', 'Private Event'],
  ['corporate', 'Corporate Event'],
  ['conference', 'Conference'],
  ['debut', 'Debut'],
  ['other', 'Other'],
];

const maxBrowsePrice = Math.max(
  0,
  ...venuesToDisplay.map((venue) => Number(venue.price_per_night) || 0),
  ...packageOptions.map((pkg) => pkg.price),
);
---

<Layout>
  <div class="wb-page-surface events-page">
    <section class="events-hero" aria-labelledby="events-page-title">
      <div class="events-hero__inner">
        <p class="events-hero__eyebrow">Woodberry Resort and Events</p>
        <h1 id="events-page-title" class="events-hero__title">
          Venues for Every Celebration
        </h1>
        <p class="events-hero__intro">
          Explore warm, nature-inspired spaces for weddings, private gatherings,
          retreats, and milestone celebrations at Woodberry.
        </p>
      </div>
    </section>

    <div class="events-showcase">
      <div class="events-showcase__inner">
        <div class="wb-section-header">
          <div class="wb-section-header__content">
            <p class="wb-section-header__eyebrow">Available venues</p>
            <h2 class="wb-section-header__title">
              Choose the setting that fits your event
            </h2>
            <p class="wb-section-header__description">
              Browse our current venue selection. Booking opens after sign in,
              while venue details remain available for everyone to review.
            </p>
          </div>
        </div>

        {venuesToDisplay.length > 0 && (
          <section class="events-filters wb-card" aria-labelledby="events-filter-title">
            <div class="events-filters__heading">
              <div>
                <p class="wb-section-header__eyebrow">Refine your search</p>
                <h2 id="events-filter-title">Find your best fit</h2>
              </div>
              <p class="events-results" aria-live="polite">
                Showing <strong data-result-count>{venuesToDisplay.length}</strong>
                <span data-result-label>{venuesToDisplay.length === 1 ? ' matching result' : ' matching results'}</span>
              </p>
            </div>

            <form class="events-filter-form" data-events-filter-form>
              <label>
                <span>Venue</span>
                <select name="venue">
                  <option value="">All venues</option>
                  {venuesToDisplay.map((venue) => <option value={venue.id}>{venue.name}</option>)}
                </select>
              </label>
              <label>
                <span>Package type</span>
                <select name="package">
                  <option value="">All packages</option>
                  {packageOptions.map((pkg) => <option value={pkg.value}>{pkg.label}</option>)}
                </select>
              </label>
              <label>
                <span>Event type</span>
                <select name="eventType">
                  <option value="">All event types</option>
                  {eventTypeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </label>
              <label>
                <span>Expected guests</span>
                <input name="guests" type="number" min="1" step="1" inputmode="numeric" placeholder="How many guests?" />
              </label>
              <label>
                <span>Minimum base price</span>
                <input name="minPrice" type="number" min="0" step="1" inputmode="decimal" placeholder="₱0" />
              </label>
              <label>
                <span>Maximum base price</span>
                <input name="maxPrice" type="number" min="0" step="1" inputmode="decimal" placeholder={maxBrowsePrice ? `₱${maxBrowsePrice.toLocaleString('en-PH')}` : 'Any price'} />
              </label>
              <label>
                <span>Sort by</span>
                <select name="sort">
                  <option value="name-asc">Name: A to Z</option>
                  <option value="name-desc">Name: Z to A</option>
                  <option value="price-asc">Price: low to high</option>
                  <option value="price-desc">Price: high to low</option>
                  <option value="capacity-asc">Capacity: low to high</option>
                  <option value="capacity-desc">Capacity: high to low</option>
                </select>
              </label>
              <div class="events-filter-form__actions">
                <button type="reset" class="events-filter-button events-filter-button--secondary" data-clear-filters>Clear Filters</button>
              </div>
              <p class="events-filter-form__note">
                Prices are base estimates. Add-ons and final arrangements may change the total.
              </p>
            </form>
          </section>
        )}

        {
          venuesToDisplay.length > 0 ? (
            <>
              <div class="events-grid" data-events-grid>
                {venuesToDisplay.map((venue) => {
                  const compatiblePackages = packageOptions.filter((pkg) => !venue.capacity || venue.capacity >= pkg.minGuests);
                  const packageSummary = compatiblePackages
                    .slice(0, 3)
                    .map((pkg) => pkg.label.replace(' Package', ''))
                    .join(', ');
                  return (
                    <div
                      class="events-grid__item"
                      data-event-item
                      data-id={venue.id}
                      data-name={venue.name || ''}
                      data-price={Number(venue.price_per_night) || 0}
                      data-capacity={Number(venue.capacity) || 0}
                      data-package-options={JSON.stringify(compatiblePackages)}
                    >
                      <EventCard
                        venue={venue}
                        authState={authState}
                        authEmail={user?.email ?? ''}
                        packageSummary={packageSummary ? `${packageSummary}${compatiblePackages.length > 3 ? ', more' : ''}` : ''}
                      />
                    </div>
                  );
                })}
              </div>
              <div class="wb-empty-state events-no-results" data-no-results hidden>
                <div class="wb-empty-state__icon" aria-hidden="true">WB</div>
                <h2 class="wb-empty-state__title">No matching results</h2>
                <p class="wb-empty-state__text">No venues or packages match your filters. Try adjusting your search.</p>
                <button type="button" class="events-filter-button events-empty-reset" data-clear-filters>Clear Filters</button>
              </div>
            </>
          ) : (
            <div class="wb-empty-state events-empty-state">
              <div class="wb-empty-state__icon" aria-hidden="true">
                WB
              </div>
              <h2 class="wb-empty-state__title">No venues available yet</h2>
              <p class="wb-empty-state__text">
                Our venue list is being refreshed. Please check back soon for
                Woodberry spaces ready for your next celebration.
              </p>
            </div>
          )
        }
      </div>
    </div>
    {authState !== 'verified' && <AuthRequiredModal />}
  </div>
</Layout>

<script>
  type BrowsePackage = {
    value: string;
    label: string;
    price: number;
    minGuests: number;
    maxGuests: number;
    eventTypes: string[];
  };

  const form = document.querySelector<HTMLFormElement>('[data-events-filter-form]');
  const grid = document.querySelector<HTMLElement>('[data-events-grid]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const countLabel = document.querySelector<HTMLElement>('[data-result-label]');

  if (form && grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-event-item]'));
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';
    const formatCurrency = (amount: number) => new Intl.NumberFormat('en-PH', {
      style: 'currency',
      currency: 'PHP',
      maximumFractionDigits: 0,
    }).format(amount);
    const getPackages = (item: HTMLElement): BrowsePackage[] => {
      try {
        return JSON.parse(item.dataset.packageOptions ?? '[]') as BrowsePackage[];
      } catch {
        return [];
      }
    };
    const getSelectedPackage = (item: HTMLElement, packageValue: string) =>
      getPackages(item).find((pkg) => pkg.value === packageValue);

    const updateCardDetails = (item: HTMLElement, packageValue: string) => {
      const venuePrice = Number(item.dataset.price) || 0;
      const venueCapacity = Number(item.dataset.capacity) || 0;
      const selectedPackage = packageValue ? getSelectedPackage(item, packageValue) : undefined;
      const priceBlock = item.querySelector<HTMLElement>('[data-card-price]');
      const priceLabel = item.querySelector<HTMLElement>('[data-card-price-label]');
      const priceAmount = item.querySelector<HTMLElement>('[data-card-price-amount]');
      const priceUnit = item.querySelector<HTMLElement>('[data-card-price-unit]');
      const capacity = item.querySelector<HTMLElement>('[data-card-capacity]');
      const packageSummary = item.querySelector<HTMLElement>('[data-card-package-summary]');

      if (selectedPackage) {
        if (priceBlock) priceBlock.hidden = false;
        if (priceLabel) priceLabel.textContent = `${selectedPackage.label} base price`;
        if (priceAmount) priceAmount.textContent = formatCurrency(selectedPackage.price);
        if (priceUnit) priceUnit.textContent = '';
        if (capacity) {
          const packageCapacity = venueCapacity
            ? Math.min(venueCapacity, selectedPackage.maxGuests)
            : selectedPackage.maxGuests;
          capacity.hidden = false;
          capacity.textContent = selectedPackage.minGuests === packageCapacity
            ? `For ${packageCapacity} guests`
            : `For ${selectedPackage.minGuests}–${packageCapacity} guests`;
        }
        if (packageSummary) packageSummary.textContent = `Selected package: ${selectedPackage.label}`;
        return;
      }

      if (priceBlock) priceBlock.hidden = venuePrice <= 0;
      if (priceLabel) priceLabel.textContent = 'Starting from';
      if (priceAmount) priceAmount.textContent = formatCurrency(venuePrice);
      if (priceUnit) priceUnit.textContent = '/night';
      if (capacity) {
        capacity.hidden = venueCapacity <= 0;
        capacity.textContent = venueCapacity ? `Up to ${venueCapacity} guests` : '';
      }
      if (packageSummary) packageSummary.textContent = packageSummary.dataset.defaultText ?? '';
    };

    const updateResults = () => {
      const venue = value('venue');
      const packageValue = value('package');
      const eventType = value('eventType');
      const guests = Math.max(0, Math.floor(Number(value('guests')) || 0));
      const minPrice = value('minPrice') === '' ? 0 : Math.max(0, Number(value('minPrice')) || 0);
      const maxPrice = value('maxPrice') === '' ? Number.POSITIVE_INFINITY : Math.max(0, Number(value('maxPrice')) || 0);
      const [sortField, sortDirection] = value('sort').split('-');

      const matching = items.filter((item) => {
        const venuePrice = Number(item.dataset.price) || 0;
        const capacity = Number(item.dataset.capacity) || 0;
        const packages = getPackages(item);
        const relevantPackages = packageValue
          ? packages.filter((pkg) => pkg.value === packageValue)
          : packages;
        const hasCompatiblePackage = relevantPackages.some((pkg) =>
          (!eventType || pkg.eventTypes.includes(eventType))
          && (!guests || (guests >= pkg.minGuests && guests <= pkg.maxGuests)),
        );
        const selectedPackage = packageValue
          ? relevantPackages[0]
          : undefined;
        const price = selectedPackage?.price ?? venuePrice;

        return (!venue || item.dataset.id === venue)
          && hasCompatiblePackage
          && (!guests || capacity >= guests)
          && price >= minPrice
          && price <= maxPrice;
      });

      items.sort((a, b) => {
        const direction = sortDirection === 'desc' ? -1 : 1;
        if (sortField === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '') * direction;
        if (sortField === 'price') {
          const aPrice = (packageValue ? getSelectedPackage(a, packageValue)?.price : undefined) ?? (Number(a.dataset.price) || 0);
          const bPrice = (packageValue ? getSelectedPackage(b, packageValue)?.price : undefined) ?? (Number(b.dataset.price) || 0);
          return (aPrice - bPrice) * direction;
        }
        if (sortField === 'capacity' && packageValue) {
          const aPackageCapacity = getSelectedPackage(a, packageValue)?.maxGuests ?? 0;
          const bPackageCapacity = getSelectedPackage(b, packageValue)?.maxGuests ?? 0;
          const aCapacity = Math.min(Number(a.dataset.capacity) || aPackageCapacity, aPackageCapacity);
          const bCapacity = Math.min(Number(b.dataset.capacity) || bPackageCapacity, bPackageCapacity);
          return (aCapacity - bCapacity) * direction;
        }
        return ((Number(a.dataset[sortField]) || 0) - (Number(b.dataset[sortField]) || 0)) * direction;
      }).forEach((item) => grid.append(item));

      items.forEach((item) => {
        item.hidden = !matching.includes(item);
        updateCardDetails(item, packageValue);
      });
      if (count) count.textContent = String(matching.length);
      if (countLabel) countLabel.textContent = matching.length === 1 ? ' matching result' : ' matching results';
      if (noResults) noResults.hidden = matching.length !== 0;
      grid.hidden = matching.length === 0;
    };

    form.addEventListener('input', updateResults);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', () => requestAnimationFrame(updateResults));
    document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]').forEach((button) => {
      if (button.type === 'reset') return;
      button.addEventListener('click', () => form.reset());
    });
    updateResults();
  }
</script>

<style>
  .events-page {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .events-hero {
    border-bottom: 1px solid var(--wb-border);
    background:
      linear-gradient(135deg, rgba(26, 46, 16, 0.92), rgba(45, 90, 39, 0.9)),
      radial-gradient(circle at top right, rgba(237, 155, 64, 0.26), transparent 22rem),
      var(--wb-green-dark);
    color: #ffffff;
  }

  .events-hero__inner,
  .events-showcase__inner {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto;
  }

  .events-hero__inner {
    display: grid;
    gap: 0.9rem;
    padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2.75rem, 7vw, 4.75rem);
  }

  .events-hero__eyebrow {
    margin: 0;
    color: var(--wb-warm);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .events-hero__title {
    max-width: 48rem;
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.35rem, 8vw, 4.75rem);
    letter-spacing: 0;
    line-height: 1.02;
  }

  .events-hero__intro {
    max-width: 43rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .events-showcase {
    padding-top: clamp(2rem, 5vw, 3.75rem);
  }

  .events-grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .events-grid__item {
    min-width: 0;
  }

  .events-grid__item[hidden],
  .events-no-results[hidden] {
    display: none;
  }

  .events-filters {
    margin: 1.5rem 0;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .events-filters__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .events-filters__heading h2 {
    margin: 0.2rem 0 0;
    color: var(--wb-green-dark);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .events-results {
    margin: 0;
    color: var(--wb-muted);
    white-space: nowrap;
  }

  .events-results strong {
    color: var(--wb-green);
    font-size: 1.35rem;
  }

  .events-filter-form {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .events-filter-form label {
    display: grid;
    gap: 0.4rem;
    color: var(--wb-green-dark);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .events-filter-form input,
  .events-filter-form select {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-surface-soft);
    color: var(--wb-text);
    padding: 0.7rem 0.8rem;
  }

  .events-filter-form input:focus,
  .events-filter-form select:focus {
    border-color: var(--wb-green);
    outline: 3px solid color-mix(in srgb, var(--wb-green) 18%, transparent);
  }

  .events-filter-form__actions {
    display: flex;
    align-items: end;
    gap: 0.6rem;
  }

  .events-filter-form__note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--wb-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .events-filter-button {
    min-height: 2.75rem;
    flex: 1;
    border: 1px solid var(--wb-green);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-green);
    color: #fff;
    cursor: pointer;
    font-weight: 900;
    padding: 0.65rem 0.8rem;
  }

  .events-filter-button--secondary {
    background: transparent;
    color: var(--wb-green-mid);
  }

  .events-filter-button:hover {
    background: var(--wb-green-mid);
  }

  .events-filter-button--secondary:hover {
    background: var(--wb-green-soft);
    color: var(--wb-green-dark);
  }

  .events-empty-reset {
    width: min(100%, 12rem);
    flex: none;
    margin-top: 0.35rem;
  }

  .events-no-results {
    margin-top: 1rem;
  }

  .events-empty-state {
    margin-top: 0.5rem;
  }

  :global(html.dark) .events-hero {
    border-bottom-color: var(--wb-border);
    background:
      linear-gradient(135deg, rgba(13, 18, 12, 0.96), rgba(32, 41, 29, 0.95)),
      radial-gradient(circle at top right, rgba(240, 174, 99, 0.14), transparent 22rem),
      var(--wb-surface);
  }

  :global(html.dark) .events-hero__title {
    color: var(--wb-text);
  }

  :global(html.dark) .events-hero__intro {
    color: var(--wb-muted);
  }

  :global(html.dark) .events-hero__eyebrow {
    color: var(--wb-warm);
  }

  @media (max-width: 640px) {
    .events-hero__inner,
    .events-showcase__inner {
      width: min(100% - 1.5rem, 72rem);
    }

    .events-filters__heading {
      align-items: start;
      flex-direction: column;
    }

    .events-filter-form {
      grid-template-columns: 1fr;
    }

    .events-filter-form__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (min-width: 641px) and (max-width: 960px) {
    .events-filter-form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
