---
const { venue, authState = 'guest', authEmail = '', packageSummary = '' } = Astro.props;
const bookingUrl = `/events_and_booking/events/${venue.id}`;
const venueName = venue.name || 'this venue';
const venuePrice = Number(venue.price_per_night) || 0;
const requiresVerification = authState === 'unverified';
---

<!-- Refactored to receive individual venue as prop and render single card -->
<div
  class="event-card wb-card wb-card--interactive overflow-hidden w-full h-full flex flex-col"
>
  {
    venue.image_url && (
      <img
        src={venue.image_url || '/placeholder.svg'}
        alt={venueName}
        class="event-card__image"
      />
    )
  }

  <div class="event-card__body">
    <h3 class="event-card__title">
      {venueName}
    </h3>

    <div class="event-card__details">
      {venue.location && <span>{venue.location}</span>}
      {venue.capacity && <span>Up to {venue.capacity} guests</span>}
    </div>

    {
      venue.description && (
        <p class="event-card__description">
          {venue.description.substring(0, 100)}...
        </p>
      )
    }

    {
      venuePrice > 0 && (
        <div class="event-card__price">
          <p class="event-card__price-label">Starting from</p>
          <p class="event-card__price-value">
            {new Intl.NumberFormat('en-PH', {
              style: 'currency',
              currency: 'PHP',
              maximumFractionDigits: 0,
            }).format(venuePrice)}
            <span>/night</span>
          </p>
        </div>
      )
    }

    {
      authState === 'verified' ? (
        <a
          href={bookingUrl}
          class="event-card__book-button"
        >
          Book Now
        </a>
      ) : (
        <button
          type="button"
          class="event-card__book-button"
          data-auth-required-trigger
          data-auth-required-reason={requiresVerification ? 'unverified' : 'guest'}
          data-auth-email={authEmail}
          data-venue-id={venue.id}
          data-venue-name={venueName}
          data-booking-url={bookingUrl}
        >
          {requiresVerification ? 'Verify Email to Book' : 'Book Now'}
        </button>
      )
    }

    {packageSummary && (
      <p class="event-card__packages">
        Packages: {packageSummary}
      </p>
    )}
  </div>
</div>

<style>
  .event-card {
    border-radius: var(--wb-radius-lg);
  }

  .event-card__image {
    width: 100%;
    height: 13rem;
    object-fit: cover;
  }

  .event-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }

  .event-card__title {
    margin: 0;
    color: var(--wb-green-dark);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    letter-spacing: 0;
    line-height: 1.2;
  }

  .event-card__description {
    flex: 1;
    margin: 0.65rem 0 1.1rem;
    color: var(--wb-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .event-card__details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-top: 0.65rem;
    color: var(--wb-green-mid);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .event-card__details span + span::before {
    content: "\2022";
    margin-right: 0.8rem;
    color: var(--wb-warm);
  }

  .event-card__price {
    margin-bottom: 0.75rem;
  }

  .event-card__price-label {
    margin: 0;
    color: var(--wb-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-card__price-value {
    margin: 0.15rem 0 0;
    color: var(--wb-warm);
    font-size: 1.7rem;
    font-weight: 900;
    line-height: 1.1;
  }

  .event-card__price-value span {
    color: var(--wb-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .event-card__packages {
    margin: 0 0 1rem;
    color: var(--wb-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .event-card__book-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    border: 0;
    border-radius: var(--wb-radius-sm);
    background: var(--wb-green);
    box-shadow: 0 12px 22px rgba(74, 124, 63, 0.16);
    color: #ffffff;
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.25;
    padding: 0.75rem 1rem;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .event-card__book-button:hover {
    background: var(--wb-green-mid);
    box-shadow: var(--wb-shadow-md);
    transform: translateY(-1px);
  }

  :global(html.dark) .event-card__book-button {
    background: var(--wb-green-mid);
    color: #10170e;
  }

  :global(html.dark) .event-card__book-button:hover {
    background: #d5efc9;
  }
</style>
