---
import CalendarPreview from './calendarComps/calendarPreview.astro';
import Theme from './ThemeButton.astro';
import { getDashboardPathForRole, getUserRole } from '../lib/adminGuard';

const pathname = Astro.url.pathname;
const roleInfo = await getUserRole(Astro.cookies);
const user = roleInfo.role === 'none' ? null : roleInfo.user;
const dashboardHref = getDashboardPathForRole(roleInfo.role);
const dashboardLabel = roleInfo.role === 'admin'
  ? 'Admin Dashboard'
  : roleInfo.role === 'staff'
    ? 'Staff Dashboard'
    : 'Dashboard';

const navItems = [
  { href: '/', label: 'Home', active: pathname === '/' },
  {
    href: '/events_and_booking/events',
    label: 'Packages / Events',
    active: pathname.startsWith('/events_and_booking'),
  },
  {
    href: '/gallery',
    label: 'Gallery',
    active: pathname.startsWith('/gallery'),
  },
  {
    href: '/contact-us',
    label: 'Contact',
    active: pathname.startsWith('/contact-us'),
  },
];
---

<header id="navbar" class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label="Woodberry home">
      <img
        src="/company-logo-clean.png"
        alt="The Woodberry Resorts and Events"
        width="240"
        height="72"
      />
    </a>

    <button
      id="mobileNavToggle"
      class="mobile-nav-toggle"
      type="button"
      aria-controls="siteNavigationPanel"
      aria-expanded="false"
      aria-label="Open navigation"
    >
      <svg class="mobile-nav-toggle__menu" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="mobile-nav-toggle__close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div id="siteNavigationPanel" class="site-header__panel">
      <nav class="site-nav" aria-label="Main navigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        <a href="/events_and_booking/events" class="book-now-link">
          Book Now
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>

        <div class="header-account-actions">
          {user ? (
            <>
              <a
                href={dashboardHref}
                class="header-action-link"
              >
                {dashboardLabel}
              </a>
              <form method="POST" action="/api/auth/signout">
                <button type="submit" class="header-action-link header-action-link--logout">
                  Logout
                </button>
              </form>
            </>
          ) : (
            <>
              <a href="/signin" class="header-action-link">Log In</a>
              <a href="/signup" class="header-action-link header-action-link--signup">
                Sign Up
              </a>
            </>
          )}
        </div>

        <div class="header-utilities">
          <button
            id="preview"
            class="header-utility-button"
            type="button"
            aria-label="Check availability"
          >
            <svg id="previewIconCal" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="17" rx="2"></rect>
              <path d="M3 10h18M8 2v4M16 2v4"></path>
            </svg>
            <svg
              id="previewIconX"
              viewBox="0 0 24 24"
              aria-hidden="true"
              style="display: none;"
            >
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
            <span id="previewText">Availability</span>
          </button>
          <div class="header-theme"><Theme /></div>
        </div>
      </div>
    </div>
  </div>
</header>

<CalendarPreview />

<script>
  function setupSiteHeader() {
    const header = document.getElementById('navbar');
    const toggle = document.getElementById('mobileNavToggle');
    const panel = document.getElementById('siteNavigationPanel');

    if (!header || !toggle || !panel || header.dataset.navigationReady) return;
    header.dataset.navigationReady = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-mobile-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      document.body.classList.toggle('mobile-navigation-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) setOpen(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSiteHeader);
  } else {
    setupSiteHeader();
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    height: 70px;
    border-bottom: 1px solid rgba(221, 232, 212, 0.9);
    background: rgba(247, 249, 244, 0.96);
    box-shadow: 0 4px 20px rgba(26, 46, 16, 0.08);
    backdrop-filter: blur(16px);
  }

  .site-header__bar {
    display: flex;
    width: min(100% - 2rem, 86rem);
    height: 100%;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    margin: 0 auto;
  }

  .site-header__logo {
    display: flex;
    width: clamp(10.5rem, 17vw, 13.5rem);
    flex: 0 0 auto;
    align-items: center;
  }

  .site-header__logo img {
    display: block;
    width: 100%;
    max-height: 58px;
    object-fit: contain;
    object-position: left center;
  }

  .site-header__panel {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .site-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(0.2rem, 1vw, 0.8rem);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    border-radius: 999px;
    color: var(--wb-text);
    font-size: clamp(0.74rem, 1vw, 0.86rem);
    font-weight: 700;
    padding: 0.55rem clamp(0.55rem, 1.1vw, 0.9rem);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
  }

  .site-nav__link.is-active::after {
    position: absolute;
    right: 0.8rem;
    bottom: 0.25rem;
    left: 0.8rem;
    height: 2px;
    border-radius: 999px;
    background: var(--wb-green);
    content: '';
  }

  .site-header__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.6rem;
  }

  .book-now-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 999px;
    background: var(--wb-green-mid);
    box-shadow: 0 8px 18px rgba(45, 90, 39, 0.18);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.7rem 1.05rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .book-now-link:hover {
    background: var(--wb-green);
    transform: translateY(-1px);
  }

  .book-now-link svg,
  .header-utility-button svg,
  .mobile-nav-toggle svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .header-account-actions,
  .header-utilities {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header-account-actions form {
    display: flex;
    margin: 0;
  }

  .header-action-link,
  .header-utility-button {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    background: transparent;
    color: var(--wb-green-dark);
    cursor: pointer;
    font: inherit;
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.55rem 0.75rem;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
  }

  .header-action-link:hover,
  .header-utility-button:hover {
    border-color: var(--wb-green);
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
  }

  .header-action-link--signup {
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
  }

  .header-action-link--logout {
    color: #8f2f20;
  }

  .header-utility-button {
    gap: 0.4rem;
    padding-inline: 0.65rem;
  }

  .header-theme {
    display: flex;
    padding-left: 0.15rem;
  }

  .mobile-nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    background: var(--wb-surface-raised);
    color: var(--wb-green-mid);
    cursor: pointer;
  }

  .mobile-nav-toggle__close {
    display: none;
  }

  :global(html.dark) .site-header {
    border-bottom-color: var(--wb-border);
    background: rgba(17, 23, 15, 0.96);
  }

  :global(html.dark) .site-nav__link,
  :global(html.dark) .header-action-link,
  :global(html.dark) .header-utility-button {
    color: var(--wb-text);
  }

  :global(html.dark) .book-now-link {
    background: var(--wb-green-mid);
    color: #10170e;
  }

  @media (max-width: 1100px) {
    .site-header__bar {
      width: min(100% - 1.5rem, 86rem);
      gap: 1rem;
    }

    .site-header__logo {
      width: 10.5rem;
    }

    .site-nav__link {
      padding-inline: 0.5rem;
    }

    .header-utility-button span,
    .header-theme {
      display: none;
    }

    .header-action-link {
      padding-inline: 0.6rem;
    }
  }

  @media (max-width: 900px) {
    .site-header__bar {
      justify-content: space-between;
    }

    .site-header__logo {
      width: 10rem;
    }

    .mobile-nav-toggle {
      display: grid;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__menu {
      display: none;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__close {
      display: block;
    }

    .site-header__panel {
      position: fixed;
      top: 70px;
      right: 0;
      left: 0;
      display: none;
      max-height: calc(100dvh - 70px);
      align-items: stretch;
      border-top: 1px solid var(--wb-border);
      background: var(--wb-surface-raised);
      box-shadow: var(--wb-shadow-lg);
      overflow-y: auto;
      padding: 1rem;
    }

    .site-header.is-mobile-open .site-header__panel {
      display: block;
    }

    .site-nav {
      display: grid;
      gap: 0.25rem;
    }

    .site-nav__link {
      min-height: 3rem;
      justify-content: space-between;
      border-radius: var(--wb-radius-sm);
      font-size: 0.9rem;
      padding: 0.7rem 0.85rem;
    }

    .site-nav__link.is-active::after {
      top: 50%;
      right: 0.8rem;
      bottom: auto;
      left: auto;
      width: 0.4rem;
      height: 0.4rem;
      transform: translateY(-50%);
    }

    .site-header__actions {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .book-now-link {
      min-height: 3rem;
      font-size: 0.88rem;
    }

    .header-account-actions,
    .header-utilities {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .header-account-actions form {
      display: block;
    }

    .header-action-link,
    .header-action-link--logout,
    .header-utility-button {
      width: 100%;
      min-height: 3rem;
      border-radius: var(--wb-radius-sm);
      font-size: 0.88rem;
    }

    .header-utility-button span,
    .header-theme {
      display: flex;
    }

    .header-theme {
      min-height: 3rem;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--wb-border);
      border-radius: var(--wb-radius-sm);
      padding: 0.5rem;
    }

    :global(html.dark) .site-header__panel {
      background: var(--wb-surface-raised);
    }

    :global(body.mobile-navigation-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 420px) {
    .site-header__bar {
      width: calc(100% - 1rem);
    }

    .site-header__logo {
      width: 9rem;
    }
  }
</style>
