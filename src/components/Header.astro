---
import CalendarPreview from './calendarComps/calendarPreview.astro';
import Theme from './ThemeButton.astro';
import { getUser } from '../lib/auth';
import { supabase, supabaseAdmin } from '../lib/supabase';

const user = await getUser(Astro.cookies);
const pathname = Astro.url.pathname;

let isAdmin = false;
if (user) {
  const client = supabaseAdmin ?? supabase;
  const { data } = await client
    .from('admins')
    .select('id')
    .eq('id', user.id)
    .single();
  isAdmin = Boolean(data);
}

const navItems = [
  { href: '/', label: 'Home', active: pathname === '/' },
  {
    href: '/events_and_booking/events',
    label: 'Packages / Events',
    active: pathname.startsWith('/events_and_booking'),
  },
  {
    href: '/gallery',
    label: 'Gallery',
    active: pathname.startsWith('/gallery'),
  },
  {
    href: '/contact-us',
    label: 'Contact',
    active: pathname.startsWith('/contact-us'),
  },
];
---

<header id="navbar" class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label="Woodberry home">
      <img
        src="/company-logo-clean.png"
        alt="The Woodberry Resorts and Events"
        width="240"
        height="72"
      />
    </a>

    <button
      id="mobileNavToggle"
      class="mobile-nav-toggle"
      type="button"
      aria-controls="siteNavigationPanel"
      aria-expanded="false"
      aria-label="Open navigation"
    >
      <svg class="mobile-nav-toggle__menu" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="mobile-nav-toggle__close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div id="siteNavigationPanel" class="site-header__panel">
      <nav class="site-nav" aria-label="Main navigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        <a href="/events_and_booking/events" class="book-now-link">
          Book Now
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>

        <details class="account-menu">
          <summary>
            <span class="account-menu__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="3.5"></circle>
                <path d="M5 20c.6-4 3-6 7-6s6.4 2 7 6"></path>
              </svg>
            </span>
            <span>{user ? 'My Account' : 'Account'}</span>
            <svg class="account-menu__chevron" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </summary>

          <div class="account-menu__panel">
            {user ? (
              <>
                <div class="account-menu__identity">
                  <span>Signed in as</span>
                  <strong>{user.email}</strong>
                </div>

                <a href="/dashboard" class="account-menu__link">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"></path>
                  </svg>
                  {isAdmin ? 'Customer Dashboard' : 'Dashboard'}
                </a>

                {isAdmin && (
                  <a href="/admin" class="account-menu__link">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="3"></circle>
                      <path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1a8 8 0 0 0-1.7-1L14.5 3h-5l-.4 3.1a8 8 0 0 0-1.7 1L5 6.1 3 9.5 5.1 11a7 7 0 0 0 0 2L3 14.5l2 3.4 2.4-1a8 8 0 0 0 1.7 1l.4 3.1h5l.4-3.1a8 8 0 0 0 1.7-1l2.4 1 2-3.4-2.1-1.5a7 7 0 0 0 .1-1Z"></path>
                    </svg>
                    Admin Dashboard
                  </a>
                )}

                <form method="POST" action="/api/auth/signout">
                  <button type="submit" class="account-menu__link account-menu__signout">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"></path>
                    </svg>
                    Sign Out
                  </button>
                </form>
              </>
            ) : (
              <div class="account-menu__auth">
                <p>Sign in to request a booking and keep track of your plans.</p>
                <a href="/signin" class="account-menu__login">Log In</a>
                <a href="/signup" class="account-menu__signup">Create Account</a>
              </div>
            )}

            <div class="account-menu__utility">
              <button id="preview" class="account-menu__utility-button" type="button">
                <svg
                  id="previewIconCal"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                  <path d="M3 10h18M8 2v4M16 2v4"></path>
                </svg>
                <svg
                  id="previewIconX"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  style="display: none;"
                >
                  <path d="m6 6 12 12M18 6 6 18"></path>
                </svg>
                <span id="previewText">Check Availability</span>
              </button>
              <div class="account-menu__theme">
                <Theme />
              </div>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<CalendarPreview />

<script>
  function setupSiteHeader() {
    const header = document.getElementById('navbar');
    const toggle = document.getElementById('mobileNavToggle');
    const panel = document.getElementById('siteNavigationPanel');

    if (!header || !toggle || !panel || header.dataset.navigationReady) return;
    header.dataset.navigationReady = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-mobile-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      document.body.classList.toggle('mobile-navigation-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        header.querySelectorAll('details[open]').forEach((details) => {
          details.removeAttribute('open');
        });
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) setOpen(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSiteHeader);
  } else {
    setupSiteHeader();
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    height: 70px;
    border-bottom: 1px solid rgba(221, 232, 212, 0.9);
    background: rgba(247, 249, 244, 0.96);
    box-shadow: 0 4px 20px rgba(26, 46, 16, 0.08);
    backdrop-filter: blur(16px);
  }

  .site-header__bar {
    display: flex;
    width: min(100% - 2rem, 86rem);
    height: 100%;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    margin: 0 auto;
  }

  .site-header__logo {
    display: flex;
    width: clamp(10.5rem, 17vw, 13.5rem);
    flex: 0 0 auto;
    align-items: center;
  }

  .site-header__logo img {
    display: block;
    width: 100%;
    max-height: 58px;
    object-fit: contain;
    object-position: left center;
  }

  .site-header__panel {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .site-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(0.2rem, 1vw, 0.8rem);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    border-radius: 999px;
    color: var(--wb-text);
    font-size: clamp(0.74rem, 1vw, 0.86rem);
    font-weight: 700;
    padding: 0.55rem clamp(0.55rem, 1.1vw, 0.9rem);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
  }

  .site-nav__link.is-active::after {
    position: absolute;
    right: 0.8rem;
    bottom: 0.25rem;
    left: 0.8rem;
    height: 2px;
    border-radius: 999px;
    background: var(--wb-green);
    content: '';
  }

  .site-header__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.6rem;
  }

  .book-now-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 999px;
    background: var(--wb-green-mid);
    box-shadow: 0 8px 18px rgba(45, 90, 39, 0.18);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.7rem 1.05rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .book-now-link:hover {
    background: var(--wb-green);
    transform: translateY(-1px);
  }

  .book-now-link svg,
  .account-menu svg,
  .mobile-nav-toggle svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .account-menu {
    position: relative;
  }

  .account-menu > summary {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    color: var(--wb-green-dark);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.55rem 0.75rem;
    list-style: none;
    white-space: nowrap;
  }

  .account-menu > summary::-webkit-details-marker {
    display: none;
  }

  .account-menu > summary:hover {
    border-color: var(--wb-green);
    background: var(--wb-green-soft);
  }

  .account-menu__icon {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border-radius: 999px;
    background: var(--wb-green-soft);
    color: var(--wb-green);
  }

  .account-menu__icon svg {
    width: 0.9rem;
  }

  .account-menu__chevron {
    width: 0.75rem !important;
    transition: transform 0.2s ease;
  }

  .account-menu[open] .account-menu__chevron {
    transform: rotate(180deg);
  }

  .account-menu__panel {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    width: min(21rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-lg);
    background: var(--wb-surface-raised);
    box-shadow: var(--wb-shadow-lg);
    color: var(--wb-text);
  }

  .account-menu__identity {
    display: grid;
    gap: 0.1rem;
    border-bottom: 1px solid var(--wb-border);
    background: var(--wb-surface-soft);
    padding: 1rem;
  }

  .account-menu__identity span {
    color: var(--wb-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-menu__identity strong {
    overflow: hidden;
    color: var(--wb-green-dark);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-menu__link {
    display: flex;
    width: 100%;
    min-height: 2.9rem;
    align-items: center;
    gap: 0.7rem;
    border: 0;
    border-bottom: 1px solid var(--wb-border);
    background: transparent;
    color: var(--wb-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.7rem 1rem;
    text-align: left;
    text-decoration: none;
    text-transform: none;
  }

  .account-menu__link:hover {
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
  }

  .account-menu__link svg {
    width: 1.05rem;
    color: var(--wb-green);
  }

  .account-menu__signout {
    border-bottom: 0;
    color: #8f2f20;
  }

  .account-menu__auth {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .account-menu__auth p {
    margin: 0 0 0.25rem;
    color: var(--wb-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .account-menu__login,
  .account-menu__signup {
    display: flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--wb-radius-sm);
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
  }

  .account-menu__login {
    background: var(--wb-green-mid);
    color: #ffffff;
  }

  .account-menu__signup {
    border: 1px solid var(--wb-border);
    color: var(--wb-green-mid);
  }

  .account-menu__utility {
    display: grid;
    gap: 0.8rem;
    border-top: 1px solid var(--wb-border);
    background: var(--wb-surface-soft);
    padding: 0.85rem 1rem;
  }

  .account-menu__utility-button {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.65rem;
    border: 0;
    border-radius: var(--wb-radius-sm);
    background: transparent;
    color: var(--wb-green-mid);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.45rem 0.25rem;
    text-align: left;
    text-transform: none;
  }

  .account-menu__utility-button:hover {
    background: var(--wb-green-soft);
  }

  .account-menu__theme {
    border-top: 1px solid var(--wb-border);
    padding-top: 0.8rem;
  }

  .mobile-nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    background: var(--wb-surface-raised);
    color: var(--wb-green-mid);
    cursor: pointer;
  }

  .mobile-nav-toggle__close {
    display: none;
  }

  :global(html.dark) .site-header {
    border-bottom-color: var(--wb-border);
    background: rgba(17, 23, 15, 0.96);
  }

  :global(html.dark) .site-nav__link,
  :global(html.dark) .account-menu > summary {
    color: var(--wb-text);
  }

  :global(html.dark) .book-now-link {
    background: var(--wb-green-mid);
    color: #10170e;
  }

  @media (max-width: 1100px) {
    .site-header__bar {
      width: min(100% - 1.5rem, 86rem);
      gap: 1rem;
    }

    .site-header__logo {
      width: 10.5rem;
    }

    .site-nav__link {
      padding-inline: 0.5rem;
    }

    .account-menu > summary > span:not(.account-menu__icon) {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .site-header__bar {
      justify-content: space-between;
    }

    .site-header__logo {
      width: 10rem;
    }

    .mobile-nav-toggle {
      display: grid;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__menu {
      display: none;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__close {
      display: block;
    }

    .site-header__panel {
      position: fixed;
      top: 70px;
      right: 0;
      left: 0;
      display: none;
      max-height: calc(100dvh - 70px);
      align-items: stretch;
      border-top: 1px solid var(--wb-border);
      background: var(--wb-surface-raised);
      box-shadow: var(--wb-shadow-lg);
      overflow-y: auto;
      padding: 1rem;
    }

    .site-header.is-mobile-open .site-header__panel {
      display: block;
    }

    .site-nav {
      display: grid;
      gap: 0.25rem;
    }

    .site-nav__link {
      min-height: 3rem;
      justify-content: space-between;
      border-radius: var(--wb-radius-sm);
      font-size: 0.9rem;
      padding: 0.7rem 0.85rem;
    }

    .site-nav__link.is-active::after {
      top: 50%;
      right: 0.8rem;
      bottom: auto;
      left: auto;
      width: 0.4rem;
      height: 0.4rem;
      transform: translateY(-50%);
    }

    .site-header__actions {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .book-now-link {
      min-height: 3rem;
      font-size: 0.88rem;
    }

    .account-menu > summary {
      min-height: 3rem;
      justify-content: center;
      border-radius: var(--wb-radius-sm);
    }

    .account-menu > summary > span:not(.account-menu__icon) {
      display: inline;
    }

    .account-menu__panel {
      position: static;
      width: 100%;
      margin-top: 0.5rem;
      box-shadow: var(--wb-shadow-sm);
    }

    :global(html.dark) .site-header__panel {
      background: var(--wb-surface-raised);
    }

    :global(body.mobile-navigation-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 420px) {
    .site-header__bar {
      width: calc(100% - 1rem);
    }

    .site-header__logo {
      width: 9rem;
    }
  }
</style>
